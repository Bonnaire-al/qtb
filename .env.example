# Copier en .env et renseigner les valeurs (ne pas commiter .env)

# URL de l'API backend
# Production (build / déploiement) : URL Railway ou domaine prod
# VITE_API_URL=https://votre-app.up.railway.app/api
#
# En local : préférer .env.development (déjà fourni) qui force localhost:5000
# en mode dev (npm run dev), sans écraser la config prod du .env.
VITE_API_URL=http://localhost:5000/api

# Mot de passe admin (page /admin) — obligatoire pour accéder à l'admin en production
# En production, pour plus de sécurité, mettre en place une authentification côté serveur
VITE_ADMIN_PASSWORD=
